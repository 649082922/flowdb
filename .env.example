# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLOWDB_SECRET_KEY=请替换为_Fernet_密钥

# 网页访问迁移 API 时使用。请设置一个至少 32 位的随机值。
FLOWDB_API_TOKEN=请替换为随机访问令牌

# 网页端口和并行任务数
FLOWDB_PORT=8080
FLOWDB_WORKERS=2

# 数据校验：表级并发、流式读取批次、精确哈希最大行数
FLOWDB_VALIDATION_CONCURRENCY=4
FLOWDB_VALIDATION_FETCH_SIZE=5000
FLOWDB_VALIDATION_MAX_ROWS=100000
FLOWDB_VALIDATION_SAMPLE_ROWS=20

# 前后端分离部署时改为实际网页域名，多个域名用逗号分隔
FLOWDB_CORS_ORIGINS=http://localhost:8080,http://localhost:3000
